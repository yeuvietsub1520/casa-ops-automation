{
  "name": "Casa - Dat ban -> Sheet -> Telegram/Zalo",
  "nodes": [
    {
      "id": "1",
      "name": "Webhook dat ban",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "booking",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "2",
      "name": "Kiem tra JSON",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ],
      "parameters": {
        "jsCode": "\nconst b = $json.body || $json;\nconst errs = [];\nfor (const k of ['name','phone','party_size','time']) if (!b[k]) errs.push('thiếu ' + k);\nlet phone = String(b.phone || '').replace(/[\\s.\\-()]/g, '');\nif (phone.startsWith('+84')) phone = '0' + phone.slice(3);\nif (phone && !/^\\+?\\d{9,12}$/.test(phone)) errs.push('sđt sai');\nconst party = parseInt(b.party_size, 10);\nif (isNaN(party) || party < 1 || party > 300) errs.push('party_size sai');\nif (b.time && isNaN(Date.parse(b.time))) errs.push('time sai');\nreturn [{ json: { valid: errs.length === 0, errors: errs.join(', '),\n  received_at: new Date().toISOString(), name: String(b.name || '').trim(), phone,\n  party_size: party, time: b.time, source: String(b.source || 'website').toLowerCase(),\n  note: b.note || '', type: b.type === 'event' ? 'event' : 'table', lang: b.lang || 'vi', large: party >= 10 } }];\n"
      }
    },
    {
      "id": "3",
      "name": "Hop le?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        440,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.valid }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "4",
      "name": "Ghi Google Sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        660,
        200
      ],
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $env.SHEET_ID }}"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "DatBan"
        },
        "columns": {
          "mappingMode": "autoMapInputData",
          "value": {}
        },
        "options": {}
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "id": "5",
      "name": "Bao Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        880,
        120
      ],
      "parameters": {
        "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
        "text": "={{ $('Kiem tra JSON').item.json.large ? '🎉 TIỆC LỚN ' : '' }}Đặt bàn mới: {{ $('Kiem tra JSON').item.json.name }} · {{ $('Kiem tra JSON').item.json.party_size }} khách · {{ $('Kiem tra JSON').item.json.time }} · {{ $('Kiem tra JSON').item.json.source }}",
        "additionalFields": {}
      },
      "retryOnFail": true,
      "maxTries": 3
    },
    {
      "id": "6",
      "name": "Bao Zalo OA",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        280
      ],
      "parameters": {
        "method": "POST",
        "url": "https://openapi.zalo.me/v3.0/oa/message/cs",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "access_token",
              "value": "={{ $env.ZALO_OA_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({recipient:{user_id:$env.ZALO_USER_ID},message:{text:'Đặt bàn mới: '+$('Kiem tra JSON').item.json.name+' '+$('Kiem tra JSON').item.json.party_size+' khách '+$('Kiem tra JSON').item.json.time}}) }}",
        "options": {}
      },
      "retryOnFail": true,
      "maxTries": 3,
      "onError": "continueRegularOutput"
    },
    {
      "id": "7",
      "name": "Tra 201",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1100,
        200
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"status\":\"created\"}",
        "options": {
          "responseCode": 201
        }
      }
    },
    {
      "id": "8",
      "name": "Tra 422",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        660,
        420
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({error: $json.errors}) }}",
        "options": {
          "responseCode": 422
        }
      }
    }
  ],
  "connections": {
    "Webhook dat ban": {
      "main": [
        [
          {
            "node": "Kiem tra JSON",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Kiem tra JSON": {
      "main": [
        [
          {
            "node": "Hop le?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Hop le?": {
      "main": [
        [
          {
            "node": "Ghi Google Sheet",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Tra 422",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Ghi Google Sheet": {
      "main": [
        [
          {
            "node": "Bao Telegram",
            "type": "main",
            "index": 0
          },
          {
            "node": "Bao Zalo OA",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Bao Telegram": {
      "main": [
        [
          {
            "node": "Tra 201",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "casa-error-alert"
  },
  "active": false
}